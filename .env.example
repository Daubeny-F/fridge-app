# Reference only: Django reads process environment variables.
# This file is NOT automatically loaded. See README for PowerShell examples.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a long random key on a deployed server; local development generates one.
DJANGO_SECRET_KEY=
# Emails are manual. Default mode saves local outbox previews.
# For Gmail, prefer start-gmail.ps1, which prompts for credentials without saving them.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fridgewise <kitchen@example.com>
